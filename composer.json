{
  "require": {
    "nikic/php-parser": "^5.0",
    "league/climate": "^3.10"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.4",
    "friendsofphp/php-cs-fixer": "^3.40"
  },
  "autoload": {
    "psr-4": {
      "PhpAot\\": "src"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "scripts": {
    "cs-fix": "php-cs-fixer fix $1",
    "analyse": "phpstan analyse --memory-limit 512M -l 5 -c phpstan.neon",
    "rector": "rector process --clear-cache"
  }
}
